FROM scratch

LABEL org.opencontainers.image.title="ktunnel frps" \
      org.opencontainers.image.version="0.71.0" \
      org.opencontainers.image.source="https://github.com/fatedier/frp" \
      org.opencontainers.image.licenses="Apache-2.0"

# fetch-frps.sh stages this file mode 0555. Plain COPY also works with the
# legacy builder shipped on some NAS Docker installations.
COPY frps /usr/local/bin/frps

ENTRYPOINT ["/usr/local/bin/frps"]
CMD ["-c", "/etc/frp/frps.toml"]
